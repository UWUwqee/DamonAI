# GEMINI_API_KEY: Primary AI Provider (Google Gemini API).
# AI Studio automatically injects this at runtime from user secrets.
# 100% Free tier available at: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: High-speed Backup AI Provider (Groq Cloud).
# 100% Free tier (ultra-fast 500+ tokens/sec, no credit card required).
# Hosts Llama 3.3 70B Versatile, DeepSeek R1 Distill, and Qwen 2.5 Coder.
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Multi-Model Backup AI Provider (OpenRouter).
# 100% Free models (Llama 3.3 70B Free, DeepSeek R1 Free, Qwen 2.5 Coder Free).
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# HUGGINGFACE_API_KEY: Open Source Backup AI Provider (Hugging Face Serverless).
# 100% Free community tier token.
# Get free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
